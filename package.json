{
  "name": "maxforge",
  "version": "0.1.4",
  "description": "Unofficial text-first DSL compiler for generating Max/MSP .maxpat patches",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "maxforge": "dist/cli/index.js",
    "maxforge-mcp": "dist/mcp/server.js"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "dev": "tsc --watch",
    "mcp": "node dist/mcp/server.js",
    "test": "node --experimental-vm-modules node_modules/.bin/vitest run",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/vitest",
    "cli": "node --loader ts-node/esm src/cli/index.ts",
    "pack:dry-run": "npm pack --dry-run"
  },
  "keywords": [
    "max",
    "maxmsp",
    "maxpat",
    "cycling74",
    "dsl",
    "compiler",
    "patcher",
    "max-patcher",
    "generative",
    "visual-programming"
  ],
  "author": "2bit",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "files": [
    "dist/",
    "data/objects.json",
    "README.md",
    "SKILL.md",
    "docs/dsl-spec.md",
    "docs/agent-guide.md",
    "docs/patch-sync.md",
    "examples/**/*.maxdsl",
    "examples/**/*.maxpat",
    "examples/**/*.json",
    "examples/**/*.cjs",
    "examples/**/README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/2bbb/maxforge.git"
  },
  "bugs": {
    "url": "https://github.com/2bbb/maxforge/issues"
  },
  "homepage": "https://github.com/2bbb/maxforge#readme",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  }
}
