{
  "name": "maxforge",
  "version": "0.4.3",
  "description": "Unofficial text-first DSL compiler for generating Max/MSP .maxpat patches",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "maxforge": "dist/cli/index.js",
    "maxforge-mcp": "dist/mcp/bin.js",
    "maxforge-broker": "dist/mcp/broker-bin.js"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "pretest:coverage": "npm run build",
    "dev": "tsc --watch",
    "docs:check": "python3 scripts/verify-markdown-links.py",
    "mcp": "node dist/mcp/bin.js",
    "test": "node --experimental-vm-modules node_modules/.bin/vitest run",
    "test:coverage": "node --experimental-vm-modules node_modules/.bin/vitest run --coverage",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/vitest",
    "cli": "npm run build --silent && node dist/cli/index.js",
    "pack:dry-run": "npm pack --dry-run"
  },
  "keywords": [
    "max",
    "maxmsp",
    "maxpat",
    "cycling74",
    "dsl",
    "compiler",
    "patcher",
    "max-patcher",
    "generative",
    "visual-programming"
  ],
  "author": "2bit",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  },
  "files": [
    "dist/",
    "data/objects.json",
    "schema/",
    "README.md",
    "skills/",
    "docs/dsl-spec.md",
    "docs/cli.md",
    "docs/agent-guide.md",
    "docs/architecture.md",
    "docs/development.md",
    "docs/mcp.md",
    "docs/node-script.md",
    "docs/object-catalog.md",
    "docs/patch-sync.md",
    "docs/releasing.md",
    "docs/website.md",
    "examples/**/*.maxdsl",
    "examples/**/*.maxpat",
    "examples/**/*.json",
    "examples/**/*.cjs",
    "examples/**/README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/2bbb/maxforge.git"
  },
  "bugs": {
    "url": "https://github.com/2bbb/maxforge/issues"
  },
  "homepage": "https://2bit.jp/maxforge/",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  }
}
